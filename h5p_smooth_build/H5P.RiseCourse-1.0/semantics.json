[
  {
    "name": "courseMeta",
    "type": "group",
    "label": "Course Information & Cover",
    "fields": [
      {
        "name": "title",
        "type": "text",
        "label": "Course Title",
        "default": "\u1798\u17c1\u179a\u17c0\u1793\u1791\u17b8\u17e1 \u1780\u17b6\u179a\u178e\u17c2\u1793\u17b6\u17c6\u17a2\u17c6\u1796\u17b8\u1797\u17b6\u179f\u17b6Java"
      },
      {
        "name": "coverImageUrl",
        "type": "text",
        "label": "Cover Image URL",
        "default": "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1600&q=80",
        "optional": true
      },
      {
        "name": "description",
        "type": "text",
        "widget": "html",
        "label": "Course Outline / Introduction",
        "enterMode": "p",
        "tags": [
          "strong",
          "em",
          "del",
          "a",
          "ul",
          "ol",
          "li",
          "h2",
          "h3",
          "p",
          "hr",
          "table",
          "pre",
          "code"
        ],
        "optional": true,
        "default": "<p>\u1793\u17c5\u1780\u17d2\u1793\u17bb\u1784\u1798\u17c1\u179a\u17c0\u1793\u1793\u17c1\u17c7 \u1799\u17be\u1784\u1793\u17b9\u1784\u179f\u17b7\u1780\u17d2\u179f\u17b6\u17a2\u17c6\u1796\u17b8\u1785\u17c6\u178e\u17bb\u1785\u179f\u17c6\u1781\u17b6\u1793\u17cb\u17d7\u1798\u17bd\u1799\u1785\u17c6\u1793\u17bd\u1793\u178a\u17bc\u1785\u1787\u17b6\u17d6</p><ul><li>\u1797\u17b6\u179f\u17b6\u1780\u17bc\u178a Java</li><li>\u1796\u17b6\u1780\u17d2\u1799\u1794\u1785\u17d2\u1785\u17c1\u1780\u1791\u17c1\u179f Syntax, Compiler, Interpreter, JVM, JRE, JDK</li><li>\u178a\u17c6\u178e\u17be\u179a\u1780\u17b6\u179a \u1793\u17c3\u1780\u17b6\u179a\u179f\u179a\u179f\u17c1\u179a\u1780\u17bc\u178a Java</li><li>\u179b\u1780\u17d2\u1781\u178e\u17c8\u179a\u1794\u179f\u17cb\u1797\u17b6\u179f\u17b6 Java</li></ul>"
      },
      {
        "name": "showCover",
        "type": "boolean",
        "label": "Show Cover Page at Start",
        "default": true
      },
      {
        "name": "startButtonText",
        "type": "text",
        "label": "Start Course Button Text",
        "default": "START COURSE",
        "optional": true
      },
      {
        "name": "exitButtonText",
        "type": "text",
        "label": "Exit Course Button Text",
        "default": "EXIT COURSE",
        "optional": true
      }
    ]
  },
  {
