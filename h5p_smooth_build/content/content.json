            "params": {
              "content": [
                {
                  "content": {
                    "library": "H5P.AdvancedText 1.1",
                    "params": {
                      "text": "<div class=\"rise-header-block\"><h2 class=\"rise-main-title\">\u179b\u1791\u17d2\u1792\u1795\u179b\u179a\u17c6\u1796\u17b9\u1784\u1791\u17bb\u1780\u1793\u17c3\u1798\u17c1\u179a\u17c0\u1793</h2><p class=\"rise-main-desc\">\u1780\u17d2\u179a\u17c4\u1799\u1794\u1789\u17d2\u1785\u1794\u17cb\u1798\u17c1\u179a\u17c0\u1793\u1793\u17c1\u17c7 \u179f\u17b7\u1780\u17d2\u1781\u17b6\u1780\u17b6\u1798\u1793\u17b9\u1784\u1791\u1791\u17bd\u179b\u1794\u17b6\u1793\u1785\u17c6\u178e\u17c1\u17c7\u178a\u17b9\u1784 \u1793\u17b7\u1784\u1787\u17c6\u1793\u17b6\u1789\u178a\u17bc\u1785\u1781\u17b6\u1784\u1780\u17d2\u179a\u17c4\u1798\u17d6</p></div>"
                    },
