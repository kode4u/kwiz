        {
          "title": "\u17e2. \u17a2\u17d2\u179c\u17b8\u1791\u17c5\u1787\u17b6Java",
          "iconType": "document",
          "content": {
            "library": "H5P.Column 1.22",
            "params": {
              "content": [
                {
                  "content": {
                    "library": "H5P.AdvancedText 1.1",
                    "params": {
                      "text": "<div class=\"rise-header-block\"><h2 class=\"rise-main-title\">\u17e2. \u17a2\u17d2\u179c\u17b8\u1791\u17c5\u1787\u17b6 Java?</h2><p class=\"rise-main-desc\">Java \u1782\u17ba\u1787\u17b6\u1797\u17b6\u179f\u17b6\u179f\u179a\u179f\u17c1\u179a\u1780\u1798\u17d2\u1798\u179c\u17b7\u1792\u17b8\u1780\u1798\u17d2\u179a\u17b7\u178f\u1781\u17d2\u1796\u179f\u17cb (High-level Programming Language) \u1794\u1784\u17d2\u1780\u17be\u178f\u17a1\u17be\u1784\u178a\u17c4\u1799 James Gosling \u1793\u17c5\u1780\u17d2\u179a\u17bb\u1798\u17a0\u17ca\u17bb\u1793 Sun Microsystems \u1780\u17d2\u1793\u17bb\u1784\u1786\u17d2\u1793\u17b6\u17c6 1995 \u1780\u17d2\u179a\u17c4\u1798\u1796\u17b6\u1780\u17d2\u1799\u179f\u17d2\u179b\u17c4\u1780 <strong>Write Once, Run Anywhere (WORA)</strong>\u17d4</p></div><div class=\"rise-callout rise-callout-tip\"><div><strong>\u1782\u17c6\u179a\u17bc\u1780\u17bc\u178a\u178a\u17c6\u1794\u17bc\u1784 (First Java Program):</strong> \u1781\u17b6\u1784\u1780\u17d2\u179a\u17c4\u1798\u1793\u17c1\u17c7\u1787\u17b6\u1791\u1798\u17d2\u179a\u1784\u17cb\u1780\u17bc\u178a\u1798\u17bc\u179b\u178f\u17d2\u178b\u17b6\u1793\u1793\u17c3\u1797\u17b6\u179f\u17b6 Java \u178a\u17be\u1798\u17a1\u17be\u1794\u1784\u17d2\u17a0\u17b6\u1789\u1796\u17b6\u1780\u17d2\u1799\u179f\u17d2\u179c\u17b6\u1782\u1798\u1793\u17cd\u17d6</div></div><pre><code class=\"language-java\">// \u1780\u1798\u17d2\u1798\u179c\u17b7\u1792\u17b8\u1794\u1784\u17d2\u17a0\u17b6\u1789\u1796\u17b6\u1780\u17d2\u1799\u179f\u17d2\u179c\u17b6\u1782\u1798\u1793\u17cd\u178a\u17c6\u1794\u17bc\u1784\u1780\u17d2\u1793\u17bb\u1784 Java\npublic class HelloWorld {\n    public static void main(String[] args) {\n        System.out.println(\"\u179f\u17bc\u179f\u17d2\u178f\u17b8\u1796\u17b7\u1797\u1796\u179b\u17c4\u1780! Hello, Java in Cambodia!\");\n    }\n}</code></pre>"
                    },
