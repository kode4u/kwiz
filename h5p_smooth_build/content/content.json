                {
                  "content": {
                    "library": "H5P.Accordion 1.0",
                    "params": {
                      "panels": [
                        {
                          "title": "\u1785\u17c6\u178e\u17c1\u17c7\u178a\u17b9\u1784 (Knowledge)",
                          "content": {
                            "library": "H5P.AdvancedText 1.1",
                            "params": {
                              "text": "<p>\u1799\u179b\u17cb\u178a\u17b9\u1784\u17a2\u17c6\u1796\u17b8\u1782\u17c4\u179b\u1780\u17b6\u179a\u178e\u17cd\u1782\u17d2\u179a\u17b9\u17c7\u1793\u17c3 Object-Oriented Programming (OOP) \u1793\u17b7\u1784\u179f\u17d2\u1790\u17b6\u1794\u178f\u17d2\u1799\u1780\u1798\u17d2\u1798 Java Virtual Machine (JVM)\u17d4</p>"
                            }
                          }
                        },
                        {
                          "title": "\u1787\u17c6\u1793\u17b6\u1789\u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f (Practical Skills)",
                          "content": {
                            "library": "H5P.AdvancedText 1.1",
                            "params": {
                              "text": "<p>\u1785\u17c1\u17c7\u178a\u17c6\u17a1\u17be\u1784 JDK, \u1780\u17c6\u178e\u178f\u17cb Environment Variables \u1793\u17b7\u1784\u179f\u179a\u179f\u17c1\u179a\u1780\u1798\u17d2\u1798\u179c\u17b7\u1792\u17b8 Console Application \u178a\u17c6\u1794\u17bc\u1784\u1794\u1784\u17d2\u17a2\u179f\u17cb\u17d4</p>"
