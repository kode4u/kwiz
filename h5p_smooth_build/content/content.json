      "sectionTitle": "\u1785\u17b6\u1794\u17cb\u1795\u17d2\u178f\u17be\u1798",
      "lessons": [
        {
          "title": "\u1791\u17b7\u178a\u17d2\u178b\u1797\u17b6\u1796\u1791\u17bc\u1791\u17c5\u1793\u17c3\u1798\u17c1\u179a\u17c0\u1793",
          "iconType": "overview",
          "content": {
            "library": "H5P.Column 1.22",
            "params": {
              "content": [
                {
                  "content": {
                    "library": "H5P.AdvancedText 1.1",
                    "params": {
                      "text": "\n<div class=\"rise-content-section\" style=\"padding-top: 10px;\">\n    <h1 class=\"rise-main-title\" style=\"font-size: 2.2rem; margin-bottom: 16px; font-weight: 800; color: #0f172a;\">ទិដ្ឋភាពទូទៅនៃមេរៀន</h1>\n    <p style=\"font-size: 1.15rem; color: #334155; margin-bottom: 28px; line-height: 1.7;\">នៅក្នុងមេរៀននេះ យើងនឹងសិក្សាអំពីចំណុចសំខាន់ៗមួយចំនួនដូចជា៖</p>\n    <ol class=\"rise-numbered-list\">\n        <li>ភាសាកូដ Java</li>\n        <li>ពាក្យបច្ចេកទេស Syntax, Compiler, Interpreter, JVM, JRE, JDK</li>\n        <li>ដំណើរការ នៃការសរសេរកូដ Java</li>\n        <li>លក្ខណៈរបស់ភាសា Java</li>\n        <li>ចេះសរសេរកូដបង្ហាញអក្សរលើអេក្រង់</li>\n    </ol>\n</div>\n"
                    },
                    "subContentId": "1e726a8e2c28bd90"
                  },
                  "useSeparator": "disabled"
                }
              ]
            },
            "subContentId": "232163edb8714ac7"
