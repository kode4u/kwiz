# Kwiz Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# ============================================
# Database Configuration (MySQL for Moodle)
# ============================================
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=moodle
MYSQL_USER=moodle
MYSQL_PASSWORD=moodlepass

# ============================================
# Moodle Configuration
# ============================================
MOODLE_URL=http://localhost:8080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=Admin@123
MOODLE_ADMIN_EMAIL=admin@example.com

# ============================================
# LLM API Service Configuration
# ============================================
LLM_API_PORT=5001
LLM_BACKEND=local
MAX_QUESTIONS=20
DEFAULT_LANGUAGE=en

# Cloud LLM Backends (optional, used if LLM_BACKEND=openai or gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.6-flash

# Local LLM (Ollama) - used when LLM_BACKEND=local
# Ollama runs on your host machine or dedicated GPU server.
# The Docker container reaches it via host.docker.internal.
LOCAL_LLM_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
LOCAL_LLM_TIMEOUT=1200
MAX_LESSON_CONTEXT_CHARS=12000

# ============================================
# Experimental Resource Limits (optional)
# Used by experiment/docker-compose.experiment.yml
# ============================================
EXP_DB_CPUS=4.00
EXP_DB_MEM_LIMIT=8g
EXP_LLMAPI_CPUS=4.00
EXP_LLMAPI_MEM_LIMIT=8g
EXP_MOODLE_CPUS=4.00
EXP_MOODLE_MEM_LIMIT=8g
EXP_PHPMYADMIN_CPUS=4.00
EXP_PHPMYADMIN_MEM_LIMIT=8g
