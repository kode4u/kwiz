<quiz>

<!-- Question 1 -->
<question type="multichoice">
    <name>
        <text>What is globalization?</text>
    </name>
    <questiontext format="html">
        <text><![CDATA[<p>What is globalization?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>

    <answer fraction="0">
        <text>The increase of government control over markets</text>
    </answer>

    <answer fraction="100">
        <text>The shift toward an integrated and interdependent world economy</text>
        <feedback><text>Correct!</text></feedback>
    </answer>

    <answer fraction="0">
        <text>The separation of national markets</text>
    </answer>

    <answer fraction="0">
        <text>The replacement of technology with manual labor</text>
    </answer>
</question>

